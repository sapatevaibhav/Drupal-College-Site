{% if content['#items'] is defined and content['#items']|length > 0 %}
    <div class="language-switcher flex items-center justify-center space-x-4 p-2">
        {% for item in content['#items'] %}
            {% set langcode = item['#language'].id %}
            {% set classes = 'px-4 py-2 rounded shadow-sm font-medium transition' %}
            {% if langcode == 'en' %}
                {% set classes = classes ~ ' bg-blue-500 text-white hover:bg-blue-600 focus:ring-2 focus:ring-offset-2 focus:ring-blue-500' %}
            {% elseif langcode == 'mr' %}
                {% set classes = classes ~ ' bg-green-500 text-white hover:bg-green-600 focus:ring-2 focus:ring-offset-2 focus:ring-green-500' %}
            {% else %}
                {% set classes = classes ~ ' bg-gray-500 text-white hover:bg-gray-600 focus:ring-2 focus:ring-offset-2 focus:ring-gray-500' %}
            {% endif %}
            <a href="{{ item['#url'] }}" class="{{ classes }}">{{ item['#title'] }}</a>
        {% endfor %}
    </div>
{% else %}
    <div class="language-switcher flex items-center justify-center space-x-4 p-2">
        <a href="/" class="px-4 py-2 bg-blue-500 text-white rounded shadow-sm font-medium hover:bg-blue-600 focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition">English</a>
        <a href="/mr" class="px-4 py-2 bg-green-500 text-white rounded shadow-sm font-medium hover:bg-green-600 focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition">मराठी</a>
    </div>
{% endif %}
