<div class="w-full">
{# {{ active_theme() }} #}
{# {{ active_theme_path() }} #}
  <header role="banner" class="bg-gray-500 text-white p-4 border-b-4 border-yellow-400">
    <div class="container mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      {% if custom_logo_enabled %}
        <div class="logo-container">
          <a href="{{ path('<front>') }}">
            <img src="{{ base_path }}themes/custom/simplecollege/images/logo.png" alt="College Logo" class="w-[100px] h-auto">
          </a>
        </div>
      {% else %}
        {# Fallback logo if custom_logo_enabled is false #}
        <div class="logo-container">
          <a href="{{ path('<front>') }}">
            <img src="{{ base_path }}themes/custom/simplecollege/images/logo.png" alt="College Logo" class="w-[100px] h-auto">
          </a>
        </div>
      {% endif %}
      <div class="text-4xl font-bold uppercase text-center md:text-left">
        My College
      </div>
      <div class="flex flex-col md:flex-row gap-4 items-center">
        <nav role="navigation" aria-labelledby="block-simplecollege-main-menu-menu" id="block-simplecollege-main-menu" class="w-full md:w-auto">
          {{ page.menu }}
        </nav>

        {# User account menu #}
        <div class="user-menu flex gap-3 items-center">
          {% if logged_in %}
            <a href="{{ path('user.page') }}" class="bg-yellow-500 hover:bg-yellow-600 text-gray-800 font-semibold py-2 px-4 rounded transition duration-300">
              {{ 'My Account'|t }}
            </a>
            <a href="{{ path('user.logout') }}" class="bg-transparent hover:bg-gray-700 text-white font-semibold hover:text-white py-2 px-4 border border-white hover:border-transparent rounded transition duration-300">
              {{ 'Log out'|t }}
            </a>
          {% else %}
            <a href="{{ path('user.login') }}" class="bg-yellow-500 hover:bg-yellow-600 text-gray-800 font-semibold py-2 px-4 rounded transition duration-300">
              {{ 'Log in'|t }}
            </a>
            <a href="{{ path('user.register') }}" class="bg-transparent hover:bg-gray-700 text-white font-semibold hover:text-white py-2 px-4 border border-white hover:border-transparent rounded transition duration-300">
              {{ 'Create account'|t }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </header>

{% if page.carousel or is_front %}
  <div class="carousel-wrapper my-4">
    {% if page.carousel %}
      {{ page.carousel }}
    {% else %}
      {# Default carousel on front page if no specific carousel content is provided #}
      {% include directory ~ '/components/carousel/carousel.twig' with {
        'items': [
          {
            'image': base_path ~ 'themes/custom/simplecollege/images/image1.jpeg',
            'alt': 'Campus life',
            'caption': 'Explore our vibrant campus community'
          },
          {
            'image': base_path ~ 'themes/custom/simplecollege/images/image2.jpeg',
            'alt': 'Student resources',
            'caption': 'Access our comprehensive student resources'
          },
          {
            'image': base_path ~ 'themes/custom/simplecollege/images/image3.jpeg',
            'alt': 'Academic excellence',
            'caption': 'Discover our renowned academic programs'
          },
          {
            'image': base_path ~ 'themes/custom/simplecollege/images/a image.webp',
            'alt': 'Campus facilities',
            'caption': 'State-of-the-art campus facilities'
          },
          {
            'image': base_path ~ 'themes/custom/simplecollege/images/image a.webp',
            'alt': 'Student activities',
            'caption': 'Get involved in exciting student activities'
          },
          {
            'image': base_path ~ 'themes/custom/simplecollege/images/college.webp',
            'alt': 'College overview',
            'caption': 'Experience college life at its best'
          },
          {
            'image': base_path ~ 'themes/custom/simplecollege/images/image.webp',
            'alt': 'Welcome to Simple College',
            'caption': 'Empowering students through education'
          }
        ],
        'id': 'homepage-carousel',
        'settings': {
          'autoplay': true,
          'autoplaySpeed': 2000,
          'dots': true,
          'arrows': true,
          'peekPercentage': 10,
          'height': 350
        }
      } %}
      {{ attach_library('simplecollege/carousel') }}
    {% endif %}
  </div>
    {% endif %}

  <div class="grid grid-cols-1 md:grid-cols-4 gap-5 p-5">
    <aside class="col-span-1">
      {% if page.left_sidebar %}
        {{ page.left_sidebar }}
      {% endif %}
    </aside>
    <main role="main" class="col-span-1 md:col-span-2">
      <a id="main-content" tabindex="-1"></a>
      <div class="bg-blue-200 p-5 rounded-lg shadow-md">
        {{ page.content }}
      </div>
    </main>
    <aside class="col-span-1">
      {% if page.right_sidebar %}
        {{ page.right_sidebar }}
      {% endif %}
      {% if page.welcome_blocks %}
        {{ page.welcome_blocks }}
      {% endif %}
    </aside>
  </div>

  {% embed 'simplecollege:chip' with {
  color: 'primary',
  dismissable: true
} %}
  {% block chip_content %}
    Type: <span>{{ node.bundle() }}</span>
  {% endblock %}
{% endembed %}

{% embed "simplecollege:info" with {
  title: "Sinhgad College",
  subtitle: "Computer Science",
  image: "/themes/custom/simplecollege/images/image1.jpeg"
} %}
  {% block content %}
    <p>{{ "Accredited with NAAC A+ Grade. Offers UG and PG courses."|t }}</p>
  {% endblock %}
{% endembed %}


  {% if page.footer %}
    <footer role="contentinfo" class="text-center p-5 bg-gray-500 text-white border-t-4 border-yellow-400">
      {{ page.footer }}
      {% if footer_text %}
        <p class="custom-footer-text">{{ footer_text }}</p>
      {% endif %}
      {{ footer_txt }}
    </footer>
  {% endif %}
</div>
