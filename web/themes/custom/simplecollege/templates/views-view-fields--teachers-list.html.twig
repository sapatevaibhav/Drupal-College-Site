<div class="flex items-center justify-between w-full">
  <div class="flex items-center">
    <div class="teacher-info">
      {% for field in fields %}
        {% if field.class == 'views-field-title' %}
          <div class="text-lg font-medium text-gray-900">{{ field.content }}</div>
        {% elseif field.class == 'views-field-field-department' %}
          <div class="text-sm text-gray-500">{{ field.content }}</div>
        {% elseif field.class == 'views-field-counter' %}
          <div class="ml-auto text-sm text-gray-400">#{{ field.content }}</div>
        {% else %}
          {{ field.content }}
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div>
    <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
    </svg>
  </div>
</div>
