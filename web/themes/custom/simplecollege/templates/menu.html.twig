{# Custom template for the main menu block #}
{% if items %}
<nav class="bg-blue-200 text-black p-4 rounded-lg shadow-lg">
  <ul class="flex flex-col-reverse gap-1">
    {% for item in items %}
      <li{{ item.attributes }}>
        <a href="{{ item.url }}" class="inline-block px-3 py-1 rounded no-underline text-black hover:bg-yellow-400">
          {{ item.title }}
        </a>
      </li>
    {% endfor %}
  </ul>
</nav>
{% else %}
<p class="text-center text-gray-300">No menu items available</p>
{% endif %}
