<article{{ attributes.addClass('mb-6') }}>

  {{ title_prefix }}
  {% if label and not page %}
    {# <marquee> #}
      <h2{{ title_attributes.addClass('text-2xl font-bold') }}>
        <a href="{{ url }}" rel="bookmark" class="text-blue-600 hover:underline">{{ label }}</a>
      </h2>
    {# </marquee> #}
  {% endif %}
  {{ title_suffix }}

  {% if display_submitted %}
    <footer class="mt-4">
      {{ author_picture }}
      <div{{ author_attributes.addClass('text-gray-600 text-sm') }}>
        {{ 'Submitted by @author on @date'|t({'@author': author_name, '@date': date}) }}
      </div>
    </footer>
  {% endif %}

  <div{{ content_attributes.addClass('prose max-w-none') }}>
    {# Apply image styling specifically for article nodes #}
    {% if attributes.hasClass('node--type-article') %}
      {{ content|merge({'#attributes': {'class': 'w-[90%] h-[400px] object-cover block'}}) }}
    {% else %}
      {{ content }}
    {% endif %}
  </div>

</article>
