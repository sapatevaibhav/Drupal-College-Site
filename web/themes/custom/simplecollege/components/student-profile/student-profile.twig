<div class="student-profile mx-auto">
  <div class="flex items-center space-x-6">
    {% if profile_picture %}
      <img src="{{ profile_picture }}" alt="{{ title }}" class="w-32 h-32 rounded-full border-4 border-blue-500 shadow-md">
    {% endif %}
    <div>
      <h1 class="text-3xl font-bold text-gray-900">{{ title }}</h1>
      <p class="text-lg text-gray-600">{{ department }}</p>
    </div>
  </div>
  <div class="mt-4">
    <h2 class="text-xl font-semibold text-gray-800">Course: {{ course }}</h2>
    <h3 class="text-lg text-gray-700">Year of Study: {{ year_of_study }}</h3>
    <p class="mt-3 text-gray-600">{{ personal_statement }}</p>
  </div>
</div>
